{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find-solutions benchmark output record",
  "type": "object",
  "required": [
    "case_id",
    "sample_id",
    "condition",
    "output"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "sample_id": {
      "type": "string"
    },
    "condition": {
      "enum": [
        "baseline",
        "release",
        "current",
        "candidate",
        "adhd"
      ]
    },
    "output": {
      "type": "string"
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "wall_time_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_manifest": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
